# Server only. Never copy provider keys into the iOS app or Git.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-flash
# Put the DeepSeek API key in this server-side secret; never in the iPhone app.
LLM_API_KEY=
# Private single-user pilot token (at least 32 random characters), entered in iOS Settings.
# This is NOT the model API key. It stays valid until replaced on the server.
LINGUAMATE_CLIENT_TOKEN=
LINGUAMATE_DAILY_LIMIT=200
